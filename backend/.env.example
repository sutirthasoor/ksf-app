# ---- Cashfree environment: sandbox | production ----
CASHFREE_ENV=sandbox

# Payment Gateway (PG) credentials  -> Cashfree dashboard > Payment Gateway > Developers > API Keys
CASHFREE_PG_APP_ID=
CASHFREE_PG_SECRET=

# Payouts credentials  -> Cashfree dashboard > Payouts > Developers > API Keys
CASHFREE_PAYOUT_CLIENT_ID=
CASHFREE_PAYOUT_CLIENT_SECRET=
# Only if your Payouts webhook uses a different secret than the client secret
CASHFREE_PAYOUT_WEBHOOK_SECRET=

# Public https URL where THIS server is reachable (used for return_url / notify_url)
PUBLIC_BASE_URL=https://your-backend.example.com

# Firebase Admin: paste the service-account JSON on ONE line, or its base64
FIREBASE_SERVICE_ACCOUNT=

# Comma-separated list of web origins allowed by CORS (mobile app needs none). Empty = allow all
CORS_ORIGINS=

# Optional limits
MAX_ORDER_AMOUNT=500000
PORT=3000
